generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  MANAGER
  OPERACIONES
  FRANQUICIA
  VENDEDOR
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum VisitStatus {
  PENDIENTE
  APROBADA
  COORDINADA
  RECHAZADA
  COMPLETADA
}

enum ManualItemType {
  PDF
  VIDEO
  TEXT
  IMAGE
}

// ─── Users & Auth ───────────────────────────────────────

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String
  name           String
  role           Role     @default(FRANQUICIA)
  avatar         String?
  active         Boolean  @default(true)
  // Toggle "recibe leads": el user entra al reparto ponderado de leads nuevos.
  receivesLeads  Boolean  @default(false)
  // Peso relativo del reparto (1 = normal; 2 = doble carga; etc.).
  leadWeight     Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  franchise   Franchise? @relation(fields: [franchiseId], references: [id])
  franchiseId String?

  tickets        Ticket[]
  ticketMessages TicketMessage[]
  visits         VisitRequest[]
  audits         Audit[]

  assignedTasks    Task[]            @relation("TaskAssignee")
  taskComments     TaskComment[]
  taskAttachments  TaskAttachment[]
  marketAnalyses   MarketAnalysis[]
  assignedLeads    FranchiseLead[]   @relation("LeadAssignee")
}

// ─── Franchises ─────────────────────────────────────────

model Franchise {
  id              String  @id @default(uuid())
  name            String
  location        String  @default("")
  zona            String  @default("")
  barrio          String  @default("")
  address         String  @default("")
  city            String  @default("")
  phone           String  @default("")
  whatsapp1       String  @default("")
  whatsapp2       String  @default("")
  googleMaps      String  @default("")
  email           String  @default("")
  responsable     String  @default("")
  status          String  @default("activa")
  openDate        String  @default("")
  employees       Int     @default(0)
  lastAuditScore  Float?
  monthlyBilling  Float   @default(0)
  notes           String  @default("")
  score           Float   @default(0)
  active          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  tickets   Ticket[]
  visits    VisitRequest[]
  audits    Audit[]
  billing   BillingData[]
  royalties Royalty[]
  ads       AdIncome[]
  salesByChannel SalesByChannel[]

  zone   Zone?   @relation(fields: [zoneId], references: [id])
  zoneId String?
}

// ─── Expansión / Análisis de Zonas ──────────────────────

model Zone {
  id                  String  @id @default(uuid())
  nombre              String
  provincia           String  @default("")
  partidoComuna       String  @default("")
  barrio              String  @default("")
  poblacion           Int     @default(0)
  densidadHabKm2      Float   @default(0)
  ingresoPromedio     Float   @default(0)
  edadMediana         Float   @default(0)
  nivelSocioeconomico String  @default("")
  oficinasCercanas    Int     @default(0)
  competenciaSushi    Int     @default(0)
  notas               String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchises Franchise[]

  @@unique([provincia, partidoComuna, barrio, nombre])
}

model BillingData {
  id              String   @id @default(uuid())
  periodo         String
  ventasBrutas    Float    @default(0)
  transacciones   Int      @default(0)
  ticketPromedio  Float    @default(0)
  notas           String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  franchiseId String

  @@unique([franchiseId, periodo])
  @@index([franchiseId])
}

model Royalty {
  id              String   @id @default(uuid())
  periodo         String
  monto           Float    @default(0)
  baseFacturacion Float    @default(0)
  porcentaje      Float    @default(0)
  estado          String   @default("pendiente")
  cobro           String   @default("JIRONOSRL")
  notas           String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  franchiseId String

  @@unique([franchiseId, periodo])
  @@index([franchiseId])
}

model AdIncome {
  id              String   @id @default(uuid())
  periodo         String
  monto           Float    @default(0)
  baseFacturacion Float    @default(0)
  porcentaje      Float    @default(0)
  estado          String   @default("pendiente")
  cobro           String   @default("JIRONOSRL")
  notas           String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  franchiseId String

  @@unique([franchiseId, periodo])
  @@index([franchiseId])
}

// ─── Finanzas: Empleados, Sueldos, Otros Gastos ─────────

model Employee {
  id        String   @id @default(uuid())
  nombre    String
  activo    Boolean  @default(true)
  notas     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  salaries  Salary[]
}

model Salary {
  id                String   @id @default(uuid())
  periodo           String
  blancoAmount      Float    @default(0)
  blancoPaidBy      String   @default("lean")
  negroAmount       Float    @default(0)
  negroPaidBy       String   @default("nacho")
  presentismoAmount Float    @default(0)
  presentismoPaidBy String   @default("nacho")
  pagado            Boolean  @default(false)
  notas             String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  @@unique([employeeId, periodo])
  @@index([employeeId])
  @@index([periodo])
}

model OtherExpense {
  id           String   @id @default(uuid())
  periodo      String
  descripcion  String
  monto        Float    @default(0)
  paidBy       String   @default("nacho")
  esPublicidad Boolean  @default(false)
  pagado       Boolean  @default(false)
  notas        String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([periodo])
}

// ─── Manual Operativo ───────────────────────────────────

model Category {
  id          String  @id @default(uuid())
  title       String  @unique
  description String  @default("")
  icon        String  @default("FileText")
  color       String  @default("text-slate-400")
  bg          String  @default("bg-slate-400/10")
  isDefault   Boolean @default(false)

  createdAt DateTime @default(now())

  items ManualItem[]
}

model ManualItem {
  id          String         @id @default(uuid())
  title       String
  description String
  type        ManualItemType
  fileName    String?
  fileUrl     String?
  textContent String?
  author      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String
}

model ManualPdf {
  id         String   @id @default(uuid())
  fileName   String
  fileUrl    String
  size       String
  uploadedAt DateTime @default(now())
  active     Boolean  @default(true)
}

// ─── Tickets ────────────────────────────────────────────

model Ticket {
  id           String         @id @default(uuid())
  title        String
  description  String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  category     String
  responseTime String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  franchise   Franchise? @relation(fields: [franchiseId], references: [id])
  franchiseId String?

  assignedAgent  String?
  assignedAvatar String?

  messages TicketMessage[]
}

model TicketMessage {
  id        String   @id @default(uuid())
  content   String
  role      String
  createdAt DateTime @default(now())

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?
}

// ─── Visitas ────────────────────────────────────────────

model VisitRequest {
  id            String      @id @default(uuid())
  motivo        String
  detalle       String
  urgency       String      @default("media")
  status        VisitStatus @default(PENDIENTE)
  scheduledDate DateTime?
  endDate       DateTime?
  assignedTo    String?
  internalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise   Franchise @relation(fields: [franchiseId], references: [id])
  franchiseId String

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String
}

// ─── Auditorías ────────────────────────────────────────

model Audit {
  id                    String   @id @default(uuid())
  fecha                 DateTime
  turno                 String
  tipoAuditoria         String
  localNotificado       String
  cocinaScores          String   @default("{}") // JSON: scores por categoría
  cajasScores           String   @default("{}") // JSON: scores por categoría
  cocinaTotal           Float    @default(0)
  cocinaMax             Float    @default(0)
  cajasTotal            Float    @default(0)
  cajasMax              Float    @default(0)
  cocinaPercent         Float    @default(0)
  cajasPercent          Float    @default(0)
  hallazgosCocina       String   @default("")
  hallazgosCaja         String   @default("")
  accionesCorrectivas       String   @default("")
  accionesCorrectivasStatus String   @default("{}")
  accionesCorrectivasFechaVencimiento DateTime?
  nivelUrgencia         String   @default("")
  localObservado        String   @default("")
  observaciones         String   @default("")
  firmaResponsable      String   @default("")
  firmaConsultor        String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise   Franchise @relation(fields: [franchiseId], references: [id])
  franchiseId String

  auditor   User   @relation(fields: [auditorId], references: [id])
  auditorId String
}

// ─── Role Permissions Config ────────────────────────────

model RolePermissionsConfig {
  id          String   @id @default("singleton")
  permissions String   @default("{}")
  updatedAt   DateTime @updatedAt
}

// ─── Audit Config ───────────────────────────────────────

model AuditConfig {
  id               String   @id @default("singleton")
  cocinaCategories String   @default("[]")
  cajasCategories  String   @default("[]")
  updatedAt        DateTime @updatedAt
}

// ─── Ono Config ─────────────────────────────────────────

model OnoConfig {
  id               String   @id @default("singleton")
  customPrompt     String   @default("")
  quickCategories  String   @default("[]")
  manualTopics     String   @default("[]")
  suggestedQueries String   @default("[]")
  temperatureRef   String   @default("[]")
  updatedAt        DateTime @updatedAt
}

model ContextFile {
  id            String   @id @default(uuid())
  fileName      String
  size          String
  extractedText String
  uploadedAt    DateTime @default(now())
}

// ─── Projects & Tasks ───────────────────────────────────

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  color       String   @default("#888888")
  archived    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections ProjectSection[]
  tasks    Task[]
}

model ProjectSection {
  id        String   @id @default(uuid())
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  tasks Task[]
}

model Task {
  id           String    @id @default(uuid())
  title        String
  description  String    @default("")
  priority     Priority  @default(NONE)
  done         Boolean   @default(false)
  startDate    DateTime?
  dueDate      DateTime?
  publishDate  DateTime?
  order        Int       @default(0)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  section   ProjectSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  sectionId String?

  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId String?

  parentTask   Task?   @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  parentTaskId String?
  subtasks     Task[]  @relation("TaskSubtasks")

  comments     TaskComment[]
  attachments  TaskAttachment[]
  dependencies TaskDependency[] @relation("TaskDependsFrom")
  dependents   TaskDependency[] @relation("TaskDependsOn")
}

model TaskComment {
  id        String   @id @default(uuid())
  body      String
  createdAt DateTime @default(now())

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId String?
}

model TaskAttachment {
  id        String   @id @default(uuid())
  fileName  String
  fileUrl   String
  mime      String?
  size      Int?
  createdAt DateTime @default(now())

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?
}

model TaskDependency {
  id String @id @default(uuid())

  task   Task   @relation("TaskDependsFrom", fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  dependsOn   Task   @relation("TaskDependsOn", fields: [dependsOnId], references: [id], onDelete: Cascade)
  dependsOnId String

  @@unique([taskId, dependsOnId])
}

// ─── Auto (tracker independiente, un solo auto) ─────────

model Auto {
  id         String   @id @default("singleton")
  nombre     String   @default("")
  valorTotal Float    @default(0)
  notas      String   @default("")
  updatedAt  DateTime @updatedAt

  cuotas AutoCuota[]
}

model AutoCuota {
  id        String   @id @default(uuid())
  monto     Float    @default(0)
  fecha     DateTime
  paidBy    String   @default("nacho")
  notas     String   @default("")
  createdAt DateTime @default(now())

  auto   Auto   @relation(fields: [autoId], references: [id], onDelete: Cascade)
  autoId String @default("singleton")

  @@index([autoId])
  @@index([fecha])
}

// ─── Market Analysis Studio (Expansión) ─────────────────
// Estudios de mercado generados con IA (Claude/OpenAI + web search) que se
// persisten con su input, output y metadata para poder revisitar.

model MarketAnalysis {
  id                String   @id @default(cuid())
  title             String
  address           String   @default("")
  lat               Float?
  lng               Float?
  radiusKm          Float    @default(4)
  rubro             String   @default("sushi delivery/takeaway")
  inputContext      String   @default("") @db.Text  // texto libre pegado por el user
  model             String   @default("both")       // 'openai' | 'anthropic' | 'both' | 'imported'
  reportMarkdown    String   @default("") @db.Text  // output principal
  reportMarkdownAlt String   @default("") @db.Text  // 2do modelo si model='both'
  citations         Json?
  status            String   @default("draft")     // 'draft' | 'generating' | 'completed' | 'failed'
  errorMessage      String   @default("")
  createdBy         User     @relation(fields: [createdById], references: [id])
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([createdById])
  @@index([createdAt])
}

// ─── Ventas — datos por canal y por día de la semana ────
// Alimenta el módulo "Ventas" (dashboard). Import inicial desde la planilla
// "Distribución de venta 2026" + upload manual por CSV.

model SalesByChannel {
  id          String   @id @default(cuid())
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  periodo     String   // "YYYY-MM"
  channel     String   // 'Local' | 'Rappi' | 'Rappi Turbo' | 'Rappi Veggie' | 'Pedidos Ya' | 'Mas delivery' | 'Mercado Pago' | 'Mercado Pago Veggie'
  orders      Int      @default(0)
  revenue     Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([franchiseId, periodo, channel])
  @@index([periodo])
  @@index([franchiseId])
}

model SalesWeekday {
  id        String   @id @default(cuid())
  periodo   String   // "YYYY-MM"
  weekday   String   // 'lunes' | 'martes' | ... | 'domingo'
  orders    Int      @default(0)
  revenue   Float    @default(0)
  updatedAt DateTime @updatedAt

  @@unique([periodo, weekday])
}

// ─── Landing Franquicias — Leads ────────────────────────

model FranchiseLead {
  id        String   @id @default(uuid())
  nombre    String
  email     String
  telefono  String   @default("")
  ciudad    String   @default("")
  mensaje   String   @default("")
  estado    String   @default("nuevo")
  notas     String   @default("")
  origen    String   @default("landing")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Vendedor asignado. null = sin asignar (queda visible solo para admin).
  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?

  @@index([estado])
  @@index([createdAt])
  @@index([assignedToId])
}
